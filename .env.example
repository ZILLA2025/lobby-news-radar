# Copy this file to ".env" (same folder) and fill in your values.
# Never share this file or upload it anywhere.

# From @BotFather in Telegram (looks like 1234567890:AAH...)
TELEGRAM_BOT_TOKEN=

# Your chat ID (a number). See README.txt step 2.
TELEGRAM_CHAT_ID=

# Optional: Anthropic API key for AI caption options. Leave empty to turn off.
ANTHROPIC_API_KEY=

# Optional: scheduled Instagram posts (README section 10)
INSTAGRAM_ACCESS_TOKEN=
GITHUB_TOKEN=
